target/
shots/
__pycache__/

# Downstream (fork) workspace build artifacts and assembled game bundles.
game/target/
game/build/

# Generated probes and editor lock files
tools/parity_probe/*/runs/
*.rbxlx.lock
tools/fidelity/truss/build.log
tools/fidelity/truss/tests.log

# Wine prefixes and Studio data folders checks leave behind: their links lead
# out of the tree (dosdevices/z: is /), and cargo walks every file git doesn't
# ignore the first time a profile builds ("failed to determine package
# fingerprint ... Permission denied").
checks/**/dosdevices/
checks/**/waxley-data/

# Studio content copied by scripts/fetch-studio-avatar.sh (Roblox content, not committed)
game/content/content/avatar/
game/content/content/fonts/
game/content/content/sky/
game/content/content/sounds/
game/content/content/textures/
game/content/PlatformContent/
game/content/ExtraContent/scripts/PlayerScripts/StarterPlayerScriptsCommon/
